---
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  robots?: string;
}

const { title, description = "Web design and SEO that generate clients. Fast websites, lead-focused design, Google Business Profile optimization, and transparent analytics.", canonical, ogImage = "/brand/og-codapixel.jpg", robots = "index, follow" } = Astro.props;
const currentUrl = canonical || Astro.url.pathname;
const SITE = 'https://codapixel.com';
const cleanPath = currentUrl === '/' ? '/' : currentUrl.replace(/\/+$/, '');
const fullUrl = `${SITE}${cleanPath}`;
const ogAbs = (ogImage === '/C logo.webp' ? '/brand/og-codapixel.jpg' : ogImage).startsWith('http') ? ogImage : SITE + encodeURI(ogImage === '/C logo.webp' ? '/brand/og-codapixel.jpg' : ogImage);
const isHome = cleanPath === '/';
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <link rel="canonical" href={fullUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="CodaPixel" />
    
    <!-- Preconnect to external resources for faster loading - Early hints -->
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    
    <!-- Fonts - Optimized for performance (async loading) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Load fonts asynchronously to prevent render blocking -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Teko:wght@500;600&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Teko:wght@500;600&display=swap" rel="stylesheet">
    </noscript>
    <!-- Fallback script for browsers that don't support preload -->
    <script is:inline>
      !function(e){"use strict";var t=function(t,n,o){function i(e){return r.body?e():void setTimeout(function(){i(e)})}function d(){l.addEventListener&&l.removeEventListener("load",d),l.media=o||"all"}var r=e.document,l=e.createElement("link");if(n)l.href=n;else{if(!(r.currentScript instanceof Element))return;l.href=r.currentScript.getAttribute("href")}l.rel="preload",l.as="style",l.addEventListener("load",function(){this.rel="stylesheet"}),l.addEventListener("load",d),l.media="print",i(function(){r.head.appendChild(l)})};"undefined"!=typeof e?e.loadCSS=t:"undefined"!=typeof define?define(function(){return t}):(e.loadCSS=t)}("undefined"!=typeof global?global:this);
    </script>

    <!-- Google Analytics - Defer loading until after page interaction -->
    <script is:inline>
      // Initialize dataLayer early for event queueing
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      
      // Load analytics script after page is fully loaded AND idle
      let analyticsLoaded = false;
      function loadAnalytics() {
        if (analyticsLoaded) return;
        analyticsLoaded = true;
        
        // Wait for idle time
        if ('requestIdleCallback' in window) {
          requestIdleCallback(function() {
            const script = document.createElement('script');
            script.src = 'https://www.googletagmanager.com/gtag/js?id=G-73YRPF7CKR';
            script.async = true;
            document.head.appendChild(script);
            
            script.onload = function() {
              gtag('js', new Date());
              gtag('config', 'G-73YRPF7CKR');
            };
          }, { timeout: 5000 });
        } else {
          // Fallback for browsers without requestIdleCallback
          setTimeout(function() {
            const script = document.createElement('script');
            script.src = 'https://www.googletagmanager.com/gtag/js?id=G-73YRPF7CKR';
            script.async = true;
            document.head.appendChild(script);
            
            script.onload = function() {
              gtag('js', new Date());
              gtag('config', 'G-73YRPF7CKR');
            };
          }, 3000);
        }
      }
      
      // Load after page load
      window.addEventListener('load', loadAnalytics);
      // Also load on first user interaction (scroll/click/touch)
      let interactionHappened = false;
      const interactionEvents = ['scroll', 'click', 'touchstart', 'keydown'];
      interactionEvents.forEach(function(event) {
        document.addEventListener(event, function() {
          if (!interactionHappened) {
            interactionHappened = true;
            loadAnalytics();
          }
        }, { once: true, passive: true });
      });
    </script>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CodaPixel" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogAbs} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />

    <!-- Organisation / LocalBusiness schema (sitewide) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ProfessionalService",
          "@id": "https://codapixel.com/#business",
          "name": "CodaPixel",
          "url": "https://codapixel.com/",
          "logo": "https://codapixel.com/brand/logo-white.png",
          "image": "https://codapixel.com/brand/og-codapixel.jpg",
          "description": "Web design, local SEO, Google Ads and Meta Ads for trade businesses in Ayrshire and across Scotland.",
          "telephone": "+447792145328",
          "priceRange": "££",
          "address": { "@type": "PostalAddress", "addressLocality": "Ayr", "addressRegion": "Ayrshire", "addressCountry": "GB" },
          "areaServed": [
            { "@type": "AdministrativeArea", "name": "Ayrshire" },
            { "@type": "City", "name": "Ayr" },
            { "@type": "City", "name": "Troon" },
            { "@type": "City", "name": "Prestwick" },
            { "@type": "City", "name": "Kilmarnock" },
            { "@type": "City", "name": "Irvine" },
            { "@type": "City", "name": "Glasgow" },
            { "@type": "Country", "name": "Scotland" }
          ],
          "hasMap": "https://www.google.com/maps?cid=15261828920523268496",
          "sameAs": ["https://www.google.com/maps?cid=15261828920523268496"],
          "knowsAbout": ["Web design", "Local SEO", "Google Business Profile", "Google Ads", "Meta Ads", "Lead tracking"],
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Services",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Website design", "url": "https://codapixel.com/services/websites" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Local SEO", "url": "https://codapixel.com/services/local-seo" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Meta Ads", "url": "https://codapixel.com/services/meta-ads" } },
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Google Ads", "url": "https://codapixel.com/services/google-ads" } }
            ]
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://codapixel.com/#website",
          "url": "https://codapixel.com/",
          "name": "CodaPixel",
          "inLanguage": "en-GB",
          "publisher": { "@id": "https://codapixel.com/#business" }
        }
      ]
    })} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
  </head>

  <body class="cx">
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      // Netlify's deploy-preview toolbar is blocked by our CSP and shows as a blank bar. Remove it on preview hosts only.
      if (location.hostname.endsWith('netlify.app')) {
        const kill = () => document.querySelectorAll('iframe[src*="app.netlify.com"]').forEach((f) => (f.closest('body > div:not(main)') || f).remove());
        new MutationObserver(kill).observe(document.documentElement, { childList: true, subtree: true });
        kill();
      }
    </script>
    <a class="cx-wa" href="https://wa.me/447792145328" aria-label="Message us on WhatsApp" onclick="try{window.gtag&&gtag('event','whatsapp_click',{event_category:'CTA',location:'sticky'})}catch(e){}"><img src="/whatsapp.svg" alt="" width="28" height="28" /><span>WhatsApp us</span></a>

    <!-- Tawk.to chat widget -->
    <script is:inline>
      var Tawk_API = Tawk_API || {}, Tawk_LoadStart = new Date();
      (function () {
        var s1 = document.createElement("script"),
          s0 = document.getElementsByTagName("script")[0];
        s1.async = true;
        s1.src = "https://embed.tawk.to/690fbc88edad88195eb785cc/1j9ingtla";
        s1.charset = "UTF-8";
        s1.setAttribute("crossorigin", "*");
        s0.parentNode.insertBefore(s1, s0);
      })();
    </script>
  </body>
</html>

<style is:global>
  @import '../index.css';
  @import '../styles/site.css';
</style>

