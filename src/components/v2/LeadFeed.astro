---
import { getLeadStats } from '../../lib/leadStats';
const s = await getLeadStats();
const rows = [
  { name: "Jimbo's Cleaning", trade: 'Exterior cleaning, Irvine', n: s.jimbos },
  { name: 'Ayrshire Fencing Group', trade: 'Fencing, Ayrshire', n: s.ayrshireFencing },
  { name: 'RB Joinery', trade: 'Joinery, Kilmarnock', n: s.rbJoinery },
];
const max = Math.max(...rows.map((r) => r.n), 1);
const fmt = (n: number) => n.toLocaleString('en-GB');
---
<div class="cp-feed" aria-label="Leads generated, from our Leadzap dashboard">
  <div class="cp-feed-top"><span>Leadzap dashboard</span><span class="cp-live">Live data</span></div>
  <div class="cp-big">{fmt(s.total)}</div>
  <div class="cp-big-label">leads generated for our clients</div>
  <div class="cp-rows">
    {rows.map((r) => (
      <div class="cp-row">
        <div><strong>{r.name}</strong><br /><span style="color:var(--cp-mute);font-size:13px">{r.trade}</span></div>
        <span class="cp-n">{fmt(r.n)}</span>
        <div class="cp-bar"><i style={`width:${Math.round((r.n / max) * 100)}%`}></i></div>
      </div>
    ))}
  </div>
  <div class="cp-feed-foot">Website enquiries logged in Leadzap, spam removed. Updated daily.</div>
</div>
