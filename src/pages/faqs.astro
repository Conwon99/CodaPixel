---
import Layout from '../layouts/Layout.astro';
import Section from '../components/site/Section.astro';
import PageHero from '../components/site/PageHero.astro';
import { faqs } from '../content/site';
---
<Layout title="FAQs | CodaPixel Web Design & Local SEO" description="Answers to common questions about CodaPixel's websites, local SEO, ads and lead tracking for trade businesses." canonical="/faqs" ogImage="/C logo.webp">
  <PageHero title="Frequently Asked Questions" hl="Questions" lead="Clear answers about how we work and what you get." crumbs={[{ label: 'FAQs' }]} />
  <Section name="faq" />
  <Section name="collab" />
</Layout>
<script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) })} />
