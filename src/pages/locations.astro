---
import Layout from '../layouts/Layout.astro';
import LocationsPage from '../components/pages/LocationsPage';
---

<Layout
  title="Locations | Web Design & SEO Services | CodaPixel"
  description="Where CodaPixel works: web design and local SEO across Ayrshire - Ayr, Troon, Prestwick, Kilmarnock, Irvine - and remotely for businesses across Scotland."
  canonical="/locations/"
  ogImage="/C logo.webp"
>
  <LocationsPage client:visible />
</Layout>

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://codapixel.com/" },
    { "@type": "ListItem", "position": 2, "name": "Locations", "item": "https://codapixel.com/locations/" }
  ]
})} />

