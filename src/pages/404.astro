---
import Layout from '../layouts/Layout.astro';
import Section from '../components/site/Section.astro';
const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Layout title="404 - Page Not Found | CodaPixel" description="Page not found" robots="noindex,follow">
  <section class="cx-404 cx-wrap">
    <b aria-hidden="true">404</b>
    <h1>This Page Took A Wrong Turn.</h1>
    <p>The page you're looking for has moved or no longer exists.</p>
    <a class="cx-btn" href="/">Back to home <span class="cx-ab" set:html={arrow} /></a>
  </section>
  <Section name="collab" />
</Layout>
