---
import Layout from '../layouts/Layout.astro';
import Section from '../components/site/Section.astro';
import PageHero from '../components/site/PageHero.astro';
---
<Layout
  title="SEO Case Studies | Real Results | CodaPixel"
  description="Real SEO results for local businesses: organic traffic growth, Google rankings and leads tracked in Leadzap."
  canonical="/case-studies"
  ogImage="/case-studies/jimbos-gsc-graph.png"
>
  <PageHero eyebrow="Results" before="Real numbers from" hl="real" after="clients" lead="Search Console data, rankings and lead counts from the businesses we work with." />
  <Section name="cases" head={false} />
  <Section name="leads" />
  <Section name="work" />
  <Section name="cta" />
</Layout>
