  { name: 'Branding', blurb: 'A comprehensive identity system for your whole brand.', m: 450, f: ['Brand strategy', 'Logo & identity', 'Brand guidelines', 'Packaging design'], hot: true },
  { name: 'UI/UX Package', blurb: 'Research-led UX for digital products people love to use.', m: 790, f: ['UX research & flows', 'Clickable prototypes', 'Usability testing', 'UI design system'] },
];
const faqs = [
  ['What Services Does Everglow Offer?', 'Brand identity, ads production, market research and content & social — from the first strategy session to launch and beyond.'],
  ['What Industries Do You Work With?', 'Mostly consumer brands, tech and professional services, from first-time founders to established teams planning their next big step.'],
