---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import HomeContact from '../components/HomeContact';
import ReviewsWidget from '../components/ReviewsWidget.astro';
---

<Layout
  title="Web Design & SEO in Ayrshire | CodaPixel"
  description="Web design and local SEO for Ayrshire businesses. Fast websites that convert, Google Business Profile optimisation and call tracking. Free website demo."
  canonical="/"
  ogImage="/C logo.webp"
>
  <Hero client:visible />

  <ReviewsWidget bordered={false} />

  <HomeContact client:idle />
</Layout>

<script is:inline>
  // Track page view - will be handled by analytics script in Layout
  if (typeof window !== 'undefined' && window.gtag) {
    window.gtag('event', 'page_view', {
      event_category: 'Navigation',
      event_label: 'Home Page',
      timestamp: new Date().toISOString()
    });
  }
</script>

