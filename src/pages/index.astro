---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import HomeContact from '../components/HomeContact';
---

<Layout
  title="Web Design & SEO in Ayrshire | CodaPixel"
  description="Websites that convert + SEO that ranks. Fast builds, GBP optimization, tracking."
  canonical="/"
  ogImage="/C logo.webp"
>
  <Hero client:visible />

  <section class="py-12 bg-white">
    <div class="container mx-auto max-w-7xl px-4">
      <!-- Elfsight Google Reviews | Untitled Google Reviews -->
      <script src="https://elfsightcdn.com/platform.js" async is:inline></script>
      <div class="elfsight-app-6d611b9b-92e1-4dd6-8023-d1abe744c5bb" data-elfsight-app-lazy></div>
    </div>
  </section>

  <HomeContact client:idle />
</Layout>

<script is:inline>
  // Track page view - will be handled by analytics script in Layout
  if (typeof window !== 'undefined' && window.gtag) {
    window.gtag('event', 'page_view', {
      event_category: 'Navigation',
      event_label: 'Home Page',
      timestamp: new Date().toISOString()
    });
  }
</script>

