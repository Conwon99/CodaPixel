---
import Layout from '../layouts/Layout.astro';
import Section from '../components/site/Section.astro';
import PageHero from '../components/site/PageHero.astro';
const detail = [
  { id: 'websites', title: 'Websites', text: 'Fast, mobile-first websites built around one job: getting the phone to ring. Clear services, real photos, reviews and a quote form on every page. We mock up a free demo before you commit.', points: ['Free demo before you pay', 'Hosting, SSL and updates included', 'Built for speed and Core Web Vitals', 'Live in days, not months'] },
  { id: 'seo', title: 'Local SEO', text: 'Rank in Google Maps and organic results for the searches your customers make, like "joiner near me" or "gutter cleaning Irvine".', points: ['Google Business Profile optimisation', 'Service pages that rank', 'Review generation strategy', 'Keyword and Search Console tracking'] },
  { id: 'ads', title: 'Meta Ads', text: 'Facebook and Instagram ads that put your work in front of local homeowners and bring in enquiries within days, while SEO builds up over the longer term.', points: ['Campaign setup and optimisation', 'Lead forms and landing pages', 'Conversion tracking', 'Ongoing ad testing'] },
  { id: 'tracking', title: 'Lead tracking', text: 'Every form enquiry and tracked call lands in Leadzap, our lead dashboard, so you can see exactly what the work brings in.', points: ['Form and call tracking', 'Spam filtering', 'Monthly lead and ranking reports', 'Search Console monitoring'] },
];
---
<Layout
  title="Web Design, Local SEO & Meta Ads for Trades | CodaPixel"
  description="Fast websites, local SEO, Google Business Profile optimisation and Meta Ads for trade businesses in Scotland, with every lead tracked."
  canonical="/services"
  ogImage="/C logo.webp"
>
  <PageHero eyebrow="Services" before="Everything you need to get" hl="found" lead="A website that turns visitors into enquiries, the local SEO to bring them in, ads when you need leads faster, and tracking that proves it." />
  <Section name="marquee" />
  <section class="cx-sec">
    <div class="cx-wrap" style="display:grid;gap:20px">
      {detail.map((d, i) => (
        <article class="cx-svc cx-svc--wide" id={d.id}>
          <div style="display:grid;gap:12px;align-content:start"><span class="cx-num">0{i + 1}</span><h2 class="cx-h2" style="font-size:clamp(28px,3vw,40px)">{d.title}</h2><p>{d.text}</p></div>
          <ul class="cx-ticks">{d.points.map((p) => <li>{p}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>
  <Section name="steps" />
  <Section name="leads" />
  <Section name="cta" />
</Layout>
