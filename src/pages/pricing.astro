---
import Layout from '../layouts/Layout.astro';
import Section from '../components/site/Section.astro';
import PageHero from '../components/site/PageHero.astro';
---
<Layout
  title="Pricing | Web Design & SEO Packages | CodaPixel"
  description="Simple monthly pricing for web design and SEO. Starter from £89/month, Growth £249/month, and Full Service lead generation at £879/month."
  canonical="/pricing"
  ogImage="/C logo.webp"
>
  <PageHero eyebrow="Pricing" before="Simple" hl="monthly" after="plans" lead="No big upfront bill. Pick the level of help you need, and move up when you're ready." />
  <Section name="pricing" head={false} />
  <Section name="faq" />
  <Section name="cta" />
</Layout>
