---
import Layout from '../layouts/Layout.astro';
import Sections from '../components/v2/Sections.astro';
---
<Layout
  title="Pricing | Web Design & SEO Packages | CodaPixel"
  description="Simple monthly pricing for web design and SEO. Starter from £89/month, Growth £249/month, and Full Service lead generation at £879/month."
  canonical="/pricing"
  ogImage="/C logo.webp"
>
  <section class="cp-page-hero">
    <div class="cp-wrap">
      <ul class="cp-eyebrow"><li>Pricing</li></ul>
      <h1 class="cp-h1">Simple <span class="cp-hl">monthly</span> plans</h1>
      <p class="cp-lead">No big upfront bill. Pick the level of help you need, and move up when you're ready.</p>
    </div>
  </section>
  <Sections name="pricing" heading={false} />
  <Sections name="faq" />
  <Sections name="cta" />
</Layout>
