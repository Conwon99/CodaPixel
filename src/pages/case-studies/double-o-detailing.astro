---
import Layout from '../../layouts/Layout.astro';
import CaseStudyDoubleOPage from '../../components/pages/CaseStudyDoubleOPage';
import ReviewsWidget from '../../components/ReviewsWidget.astro';
---

<Layout
  title="Double O Detailing: Spam Update Recovery | CodaPixel"
  description="How CodaPixel audited Double O Detailing after Google's August 2026 spam update and removed ~280 doorway and duplicate URLs. Full audit and fixes."
  canonical="/case-studies/double-o-detailing/"
>
  <CaseStudyDoubleOPage client:visible />
  <ReviewsWidget />
</Layout>

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Double O Detailing SEO Case Study: Google Spam Update Audit & Recovery",
  "description": "How CodaPixel audited Double O Detailing after the August 2026 Google spam update, removed ~280 doorway and duplicate URLs, and rebuilt the site around paint correction and ceramic coating.",
  "author": { "@type": "Organization", "name": "CodaPixel" },
  "publisher": {
    "@type": "Organization",
    "name": "CodaPixel",
    "logo": { "@type": "ImageObject", "url": "https://codapixel.com/C%20logo.webp" }
  },
  "about": {
    "@type": "LocalBusiness",
    "name": "Double O Detailing",
    "url": "https://doubleodetailing.co.uk/"
  }
})} />
